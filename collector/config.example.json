{
  "snapshot_file": "/var/lib/server-status/telemetry.json",
  "state_file": "/var/lib/server-status-collector/state.json",
  "sample_interval_seconds": 60,
  "directory_interval_seconds": 900,
  "github_interval_seconds": 300,
  "tailscale": true,
  "tunnels": [
    {
      "name": "Example application tunnel",
      "hostnames": [
        "app.example.com"
      ],
      "metrics_port": 20241,
      "expected_connections": 4
    }
  ],
  "units": [
    {
      "name": "SSH",
      "unit": "ssh.service"
    },
    {
      "name": "Example application",
      "unit": "example.service"
    },
    {
      "name": "Example user service",
      "unit": "example.service",
      "user": "example-user"
    }
  ],
  "directories": [
    {
      "name": "Application data",
      "path": "/srv/example"
    },
    {
      "name": "System logs",
      "path": "/var/log"
    }
  ],
  "jobs": [
    {
      "name": "Scheduled maintenance",
      "kind": "systemd",
      "unit": "example-maintenance.service",
      "timer": "example-maintenance.timer",
      "max_age_seconds": 7200
    },
    {
      "name": "Application backup",
      "kind": "github",
      "category": "backup",
      "repository": "example/project",
      "workflow": "backup.yml",
      "max_age_seconds": 172800
    }
  ],
  "databases": [
    {
      "name": "Shared PostgreSQL",
      "service": "example",
      "service_file": "/etc/server-status/pg_service.conf",
      "limit_bytes": 200000000
    }
  ],
  "software": {
    "interval_seconds": 21600,
    "apt": true,
    "tools": [
      {
        "name": "Node.js",
        "kind": "node",
        "executable": "/usr/bin/node"
      },
      {
        "name": "pnpm",
        "kind": "npm",
        "package": "pnpm",
        "executable": "/usr/local/bin/pnpm"
      },
      {
        "name": "Go",
        "kind": "go",
        "executable": "/usr/local/go/bin/go"
      },
      {
        "name": "Example CLI",
        "kind": "github",
        "repository": "example/project",
        "executable": "/usr/local/bin/example"
      }
    ]
  }
}
